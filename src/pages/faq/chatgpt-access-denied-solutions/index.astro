    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 0.8rem;
    display: flex;
    gap: 0.5rem;
  }
  .breadcrumb a {
    color: var(--color-accent);
    text-decoration: none;
  }
  .category-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-accent);
    background: rgba(201, 81, 53, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 0.8rem;
  }
  .article-header h1 {
    font-size: 2rem;
    line-height: 1.35;
    font-weight: 800;
